-    def _call(self, client, req, timeout):
-        fut = client.call_async(req)
-        end = time.perf_counter() + timeout
-        while not fut.done() and time.perf_counter() < end:
-            time.sleep(0.005)
-        return fut.result() if fut.done() else None
