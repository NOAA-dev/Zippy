-# nav2_planner_params.yaml
-#
-# Configures ONLY the planner_server + its global_costmap. No controller_server,
-# no bt_navigator, no AMCL -- we are deliberately not standing up local
-# planning/control, per what was asked: global path planning comparison only.
-#
-# Footprint and kinematics below are set to match a_star_node.py's declared
-# parameters as closely as Nav2's model allows:
-#   footprint_length=0.6, footprint_width=0.45, footprint_margin=0.05
-#     -> half_length+margin=0.35, half_width+margin=0.275
-#   velocity_primitives_=[0.8, 0.0, -0.5], angular_vel_primitives=+-60deg
-#     -> minimum_turning_radius = v_max / w_max = 0.8 / 1.0472 rad/s ~= 0.764 m
-#
-# IMPORTANT CAVEATS (read before trusting numbers):
-#  - Nav2's obstacle/cost landscape comes from the inflation_layer below
-#    (inflation_radius, cost_scaling_factor), which is NOT the same formula as
-#    a_star_node.py's clearance_cost_weight / min_clearance term. Both are
-#    "stay away from obstacles" penalties, but they are not numerically
-#    equivalent. This is an unavoidable difference between two independent
-#    codebases, not a bug -- don't over-read small path-shape differences
-#    near obstacles as a planner-quality gap; they may just be cost-landscape
-#    differences.
-#  - reverse_penalty (Nav2, multiplicative, default 2.0) vs
-#    reverse_move_penalty (yours, flat +10 additive) are different penalty
-#    *structures*, not just different numbers. Can't be made identical.
-#  - angle_quantization_bins: set to 72 (Nav2's documented recommended
-#    default) below. Your own search_theta_bins_=20 is coarser. Try both if
-#    you want a same-resolution comparison -- see the commented alternative.
-
-planner_server:
-  ros__parameters:
-    planner_plugins: ["GridBased"]
-    use_sim_time: False
-    GridBased:
-      plugin: "nav2_smac_planner::SmacPlannerHybrid"   # ROS2 Iron and older: "nav2_smac_planner/SmacPlannerHybrid"
-      downsample_costmap: false
-      downsampling_factor: 1
-      allow_unknown: false        # a_star_node.py treats unknown as blocked; match that
-      tolerance: 0.4              # matches your goal_dist_thresh
-      max_iterations: 1000000
-      max_on_approach_iterations: 1000
-      max_planning_time: 30.0     # raised from Nav2's 5.0s default -- your planner has
-                                   # no hard time cap (only a 10,000-expansion cap), so
-                                   # don't let Nav2 time out early and call that "faster"
-      motion_model_for_search: "REEDS_SHEPP"   # yours allows reverse (v=-0.5 primitive)
-      angle_quantization_bins: 72
-      # angle_quantization_bins: 20   # <- swap in for a same-theta-resolution run
-      minimum_turning_radius: 0.764
-      reverse_penalty: 2.0
-      change_penalty: 0.0
-      non_straight_penalty: 1.2
-      cost_penalty: 2.0
-      retrospective_penalty: 0.015
-      lookup_table_size: 20.0
-      cache_obstacle_heuristic: false
-      debug_visualizations: false
-      use_quadratic_cost_penalty: false
-      downsample_obstacle_heuristic: true
-      allow_primitive_interpolation: false
-      smooth_path: true
-      smoother:
-        max_iterations: 1000
-        w_smooth: 0.3
-        w_data: 0.2
-        tolerance: 1.0e-10
-        do_refinement: true
-        refinement_num: 2
-
-# NOTE: global_costmap MUST be a top-level key (node /global_costmap/global_costmap),
-# not nested under planner_server -- nested, its params never reach the costmap node.
-global_costmap:
-  global_costmap:
-    ros__parameters:
-      use_sim_time: False
-      global_frame: map
-      robot_base_frame: zippy   # matches the frame a_star_node.py looks up
-      resolution: 0.05
-      track_unknown_space: true
-      footprint: "[[0.35, 0.275], [0.35, -0.275], [-0.35, -0.275], [-0.35, 0.275]]"
-      footprint_padding: 0.0
-      plugins: ["static_layer", "inflation_layer"]
-      static_layer:
-        plugin: "nav2_costmap_2d::StaticLayer"
-        map_subscribe_transient_local: true
-      inflation_layer:
-        plugin: "nav2_costmap_2d::InflationLayer"
-        inflation_radius: 0.55
-        cost_scaling_factor: 3.0
-      always_send_full_costmap: true
-
-map_server:
-  ros__parameters:
-    use_sim_time: False
-    yaml_filename: "map.yaml"   # overridden by launch argument, see launch file
-
-lifecycle_manager_planner:
-  ros__parameters:
-    use_sim_time: False
-    autostart: true
-    node_names: ["map_server", "planner_server"]
\ No newline at end of file
