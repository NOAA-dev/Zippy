<launch>

    <!-- Arguments -->
    <arg name="use_sim_time" default="true"/>

    <!-- Map path -->
    <let name="map_path"
         value="$(find-pkg-share program_bringup)/maps/small_house/map.yaml"/>

    <!-- SLAM configuration -->
    <let name="slam_config"
         value="$(find-pkg-share program_bringup)/config/slam_toolbox.yaml"/>


    <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
        <param name="yaml_filename" value="$(var map_path)"/>
        <param name="frame_id" value="map"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <node pkg="slam_toolbox" exec="sync_slam_toolbox_node" name="slam_toolbox" output="screen">
        <param from="$(var slam_config)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_localization" output="screen">
        <param name="node_names" value="['map_server', 'slam_toolbox']"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="autostart" value="true"/>
        <param name="bond_timeout" value="10.0"/>
    </node>

</launch>