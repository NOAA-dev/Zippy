<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin 
            filename="gz-sim-diff-drive-system" 
            name="gz::sim::systems::DiffDrive">
            <left_joint>base_frontleft_wheel_joint</left_joint>
            <left_joint>base_rearleft_wheel_joint</left_joint>
            <right_joint>base_frontright_wheel_joint</right_joint>
            <right_joint>base_rearright_wheel_joint</right_joint>
            <wheel_separation>0.5</wheel_separation>
            <wheel_radius>0.1</wheel_radius>
            <frame_id>odom</frame_id>
            <child_frame_id>zippy</child_frame_id>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin 
            filename="gz-sim-joint-state-publisher-system" 
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_frontleft_wheel_joint</joint_name>
            <joint_name>base_frontright_wheel_joint</joint_name>
            <joint_name>base_rearleft_wheel_joint</joint_name>
            <joint_name>base_rearright_wheel_joint</joint_name>

        </plugin>
    </gazebo>

</robot>