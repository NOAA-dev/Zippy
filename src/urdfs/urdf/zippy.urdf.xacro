<?xml version="1.0"?>
<robot name="zippy" xmlns:xacro="https://www.ros.org/wiki/xacro">

    <xacro:arg name="controllers_config_path" default="" />

    <xacro:include filename="materials.xacro" />
    <xacro:include filename="inertia_descriptions.xacro" />
    <xacro:include filename="camera.xacro" />
    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="imu_sensor.xacro" />
    <xacro:include filename="gazebo_plugin.xacro" />
    <xacro:include filename="ros2_hardwareinterface.xacro" />

    <xacro:property name="chassis_length" value="0.6" />
    <xacro:property name="chassis_width" value="0.45" />
    <xacro:property name="chassis_height" value="0.25" />
    <xacro:property name="chassis_mass" value="5.0" />

    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_thickness" value="0.06" />
    <xacro:property name="wheel_mass" value="0.25" />

    <!-- Distance between left/right wheel centers and front/rear wheel centers -->
    <xacro:property name="track_width" value="0.51" />
    <xacro:property name="wheelbase" value="0.45" />

    <!-- Height of the chassis center above the ground (wheel axle height) -->
    <xacro:property name="chassis_z" value="${wheel_radius}" />

    <link name="zippy">
    </link>
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
            </geometry>
            <origin xyz="0 0 ${chassis_z}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
            </geometry>
            <origin xyz="0 0 ${chassis_z}" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia Mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}" arr_xyz="0 0 ${chassis_z}" arr_rpy="0 0 0" />
    </link>

    <xacro:macro name="wheel" params="params">
        <link name="${params}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <material name="grey"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </collision>
            <xacro:cylinder_inertia Mass="${wheel_mass}" r="${wheel_radius}" h="${wheel_thickness}" arr_xyz="0 0 0" arr_rpy="${pi/2} 0 0"/>
        </link>
    </xacro:macro>

    <xacro:wheel params="front_left_wheel" />
    <xacro:wheel params="front_right_wheel" />
    <xacro:wheel params="rear_left_wheel" />
    <xacro:wheel params="rear_right_wheel" />

    <joint name="base_frontleft_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_wheel"/>
        <origin xyz="${wheelbase/2} ${track_width/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_frontright_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_wheel"/>
        <origin xyz="${wheelbase/2} ${-track_width/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_rearleft_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_left_wheel"/>
        <origin xyz="${-wheelbase/2} ${track_width/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_rearright_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rear_right_wheel"/>
        <origin xyz="${-wheelbase/2} ${-track_width/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="spine" type="fixed">
        <parent link="zippy"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
    </joint>

    <xacro:macro name="wheel_friction" params="link">
        <gazebo reference="${link}">
            <mu1>1000000000000000.0</mu1>
            <mu2>1000000000000000.0</mu2>
            <kp>1000000000000.0</kp>
            <kd>10.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>0.1</maxVel>
            <fdir1>1 0 0</fdir1>
        </gazebo>
    </xacro:macro>

    <xacro:wheel_friction link="front_left_wheel" />
    <xacro:wheel_friction link="front_right_wheel" />
    <xacro:wheel_friction link="rear_left_wheel" />
    <xacro:wheel_friction link="rear_right_wheel" />

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg controllers_config_path)</parameters>
        </plugin>
    </gazebo>

    <!-- <gazebo>
        <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
        <render_engine>ogre2</render_engine>
        </plugin>
        <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    </gazebo> -->

</robot>